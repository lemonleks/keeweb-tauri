{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LemonKee",
  "version": "1.18.9",
  "identifier": "net.antelle.keeweb",
  "build": {
    "devUrl": "http://localhost:8085",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run prepare-sidecar && npm run dev-legacy",
    "beforeBuildCommand": "npm run prepare-sidecar && npm run build-legacy"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "externalBin": [
      "binaries/keeweb-native-messaging-host"
    ],
    "category": "Utility",
    "copyright": "Copyright © 2026 Antelle and KeeWeb contributors",
    "shortDescription": "Free cross-platform password manager compatible with KeePass",
    "longDescription": "KeeWeb is a free, open-source password manager for KeePass databases. Open existing KDBX files or create encrypted vaults to keep your credentials secure.",
    "fileAssociations": [
      {
        "ext": [
          "kdbx"
        ],
        "name": "KeePass database",
        "role": "Editor",
        "mimeType": "application/x-keepass2"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
